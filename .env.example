# Supabase Configuration (Shared across all packages)
VITE_SUPABASE_URL=https://mtqullobcsypkqgdkaob.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Gemini AI API is now proxied through Supabase Edge Functions
# Set GEMINI_API_KEY as a Supabase secret for use in Edge Functions:
# supabase secrets set GEMINI_API_KEY="your_api_key_here"
# Do NOT expose in .env files or frontend bundle

# Google Maps API (Frontend only)
VITE_GOOGLE_MAPS_API_KEY=your_maps_api_key_here

# Admin App URL (for staff role redirect)
# Dev: http://localhost:3001
# Prod: https://admin.thaiakha.com
VITE_ADMIN_APP_URL=http://localhost:3001

# Resend Email API (Admin Edge Functions only)
RESEND_API_KEY=your_resend_api_key_here

# Supabase Service Role Key (Admin Edge Functions only)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
