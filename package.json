{
  "name": "thaiakha-cherry-2026",
  "version": "1.0.0",
  "private": true,
  "description": "ThaiAkha monorepo — front (www.thaiakha.com) + admin (admin.thaiakha.com)",
  "scripts": {
    "bootstrap": "pnpm install && npx pnpm build --filter shared",
    "dev:front": "pnpm --filter front dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev": "pnpm run dev:front & pnpm run dev:admin",
    "build:front": "pnpm --filter front build",
    "build:admin": "pnpm --filter admin build",
    "build": "pnpm --filter front build && pnpm --filter admin build",
    "generate-embeddings": "tsx --env-file=.env scripts/generate-embeddings.ts",
    "gen-legal": "tsx --env-file=.env scripts/gen-legal-data.ts",
    "sync-prompts": "node scripts/sync-prompts.mjs",
    "check-prompts": "node scripts/sync-prompts.mjs --check",
    "check-ui-strings": "node scripts/check-ui-strings.mjs"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.95.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "openai": "^4.77.0",
    "tsx": "^4.21.0"
  },
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d"
}
